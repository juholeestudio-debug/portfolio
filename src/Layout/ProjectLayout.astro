---
const { title, year, medium } = Astro.props;
---

<!doctype html>
<html lang="en">

<head>

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>{title} | Juho Lee</title>

<style is:global>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    background:white;
}

body{
    font-family:Helvetica,Arial,sans-serif;
    color:black;
    background:white;
}

a{
    color:inherit;
    text-decoration:none;
}

.project-page{

    width:min(1500px,calc(100% - 80px));
    margin:auto;
    padding:60px 0 120px;

}

.back{

    display:inline-block;
    margin-bottom:60px;
    font-size:18px;
    color:#777;

}

.back:hover{

    color:black;

}

.video{

    position:relative;

    width:100%;

    aspect-ratio:16/9;

    margin-bottom:80px;

    background:black;

}

.video iframe{

    position:absolute;

    inset:0;

    width:100%;

    height:100%;

    border:none;

}

.content{

    max-width:900px;

}

h1{

    font-size:68px;

    font-weight:400;

    letter-spacing:-.05em;

    margin-bottom:20px;

}

.meta{

    color:#777;

    font-size:20px;

    margin-bottom:60px;

}

.content p{

    font-size:20px;

    line-height:1.7;

    margin-bottom:28px;

}

.project-image{

    width:100%;

    display:block;

    margin:70px 0;

}

@media(max-width:900px){

.project-page{

width:calc(100% - 36px);

padding:40px 0 80px;

}

h1{

font-size:44px;

}

.content p{

font-size:17px;

}

.meta{

font-size:16px;

}

}

</style>

</head>

<body>

<div class="project-page">

<a class="back" href="/work">

← Back

</a>

<slot />

</div>

</body>

</html>