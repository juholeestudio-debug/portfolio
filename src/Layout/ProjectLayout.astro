---
import {
  getProjectBySlug,
  getProjectNavigation,
} from "../data/projects";

interface Props {
  slug: string;
}

const { slug } = Astro.props;

const project = getProjectBySlug(slug);

if (!project) {
  throw new Error(
    `Project "${slug}" was not found in src/data/projects.ts`
  );
}

const {
  title,
  year,
  medium,
  vimeo,
  description = `${project.title} — Juho Lee`,
} = project;

const { newer, older } = getProjectNavigation(slug);

const meta = [year, medium].filter(Boolean).join(" · ");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="description"
      content={description}
    />

    <title>{title} | Juho Lee</title>

    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon.png"
    />
  </head>

  <body>
    <main class="project-page">
      <a class="back" href="/work">
        ← Back
      </a>

      {
        vimeo && (
          <div class="video">
            <iframe
              src={vimeo}
              title={`${title} video`}
              allow="autoplay; fullscreen; picture-in-picture"
              loading="lazy"
              allowfullscreen
            />
          </div>
        )
      }

      <article class="content">
        <header class="project-header">
          <h1>{title}</h1>

          {
            meta && (
              <div class="meta">
                {meta}
              </div>
            )
          }
        </header>

        <div class="project-body">
          <slot />
        </div>
      </article>

      {
        (newer || older) && (
          <nav
            class="project-navigation"
            aria-label="Project navigation"
          >
            <div
              class="project-navigation-side project-navigation-newer"
            >
              {
                newer && (
                  <a
                    href={`/work/${newer.slug}`}
                    aria-label={`Newer project: ${newer.title}`}
                  >
                    <span class="navigation-arrow">
                      ←
                    </span>

                    <span class="navigation-title">
                      {newer.title}
                    </span>
                  </a>
                )
              }
            </div>

            <div
              class="project-navigation-side project-navigation-older"
            >
              {
                older && (
                  <a
                    href={`/work/${older.slug}`}
                    aria-label={`Older project: ${older.title}`}
                  >
                    <span class="navigation-title">
                      {older.title}
                    </span>

                    <span class="navigation-arrow">
                      →
                    </span>
                  </a>
                )
              }
            </div>
          </nav>
        )
      }
    </main>

    <div
      class="lightbox"
      id="lightbox"
      aria-hidden="true"
      role="dialog"
      aria-modal="true"
      aria-label="Image preview"
    >
      <button
        class="lightbox-close"
        type="button"
        aria-label="Close image"
      >
        ×
      </button>

      <button
        class="lightbox-arrow lightbox-previous"
        type="button"
        aria-label="Previous image"
      >
        ←
      </button>

      <div class="lightbox-content">
        <img
          class="lightbox-image"
          src=""
          alt=""
        />

        <div class="lightbox-caption"></div>
      </div>

      <button
        class="lightbox-arrow lightbox-next"
        type="button"
        aria-label="Next image"
      >
        →
      </button>

      <div class="lightbox-counter"></div>
    </div>

    <script>
      const lightbox =
        document.querySelector("#lightbox");

      const lightboxImage =
        lightbox?.querySelector(".lightbox-image");

      const lightboxCaption =
        lightbox?.querySelector(".lightbox-caption");

      const lightboxCounter =
        lightbox?.querySelector(".lightbox-counter");

      const closeButton =
        lightbox?.querySelector(".lightbox-close");

      const previousButton =
        lightbox?.querySelector(".lightbox-previous");

      const nextButton =
        lightbox?.querySelector(".lightbox-next");

      const projectImages = Array.from(
        document.querySelectorAll(".project-image")
      );

      let currentImageIndex = 0;
      let previouslyFocusedElement = null;

      projectImages.forEach((image, index) => {
        if (!(image instanceof HTMLImageElement)) {
          return;
        }

        image.loading = "lazy";
        image.decoding = "async";

        image.setAttribute("tabindex", "0");
        image.setAttribute("role", "button");

        image.setAttribute(
          "aria-label",
          image.alt
            ? `Open image: ${image.alt}`
            : `Open project image ${index + 1}`
        );

        image.addEventListener("click", () => {
          openLightbox(index);
        });

        image.addEventListener("keydown", (event) => {
          if (
            event.key === "Enter" ||
            event.key === " "
          ) {
            event.preventDefault();
            openLightbox(index);
          }
        });
      });

      function updateLightbox() {
        const image = projectImages[currentImageIndex];

        if (
          !(image instanceof HTMLImageElement) ||
          !(lightboxImage instanceof HTMLImageElement)
        ) {
          return;
        }

        lightboxImage.src =
          image.currentSrc || image.src;

        lightboxImage.alt = image.alt || "";

        if (lightboxCaption) {
          lightboxCaption.textContent =
            image.dataset.caption ||
            image.alt ||
            "";
        }

        if (lightboxCounter) {
          lightboxCounter.textContent =
            projectImages.length > 1
              ? `${currentImageIndex + 1} / ${projectImages.length}`
              : "";
        }

        const hasMultipleImages =
          projectImages.length > 1;

        previousButton?.classList.toggle(
          "is-hidden",
          !hasMultipleImages
        );

        nextButton?.classList.toggle(
          "is-hidden",
          !hasMultipleImages
        );
      }

      function openLightbox(index) {
        if (
          !lightbox ||
          projectImages.length === 0
        ) {
          return;
        }

        currentImageIndex = index;
        previouslyFocusedElement =
          document.activeElement;

        updateLightbox();

        lightbox.classList.add("is-open");
        lightbox.setAttribute("aria-hidden", "false");

        document.body.classList.add(
          "lightbox-active"
        );

        if (closeButton instanceof HTMLElement) {
          closeButton.focus();
        }
      }

      function closeLightbox() {
        if (
          !lightbox ||
          !(lightboxImage instanceof HTMLImageElement)
        ) {
          return;
        }

        lightbox.classList.remove("is-open");
        lightbox.setAttribute("aria-hidden", "true");

        document.body.classList.remove(
          "lightbox-active"
        );

        window.setTimeout(() => {
          lightboxImage.src = "";
          lightboxImage.alt = "";

          if (lightboxCaption) {
            lightboxCaption.textContent = "";
          }

          if (lightboxCounter) {
            lightboxCounter.textContent = "";
          }
        }, 180);

        if (
          previouslyFocusedElement instanceof HTMLElement
        ) {
          previouslyFocusedElement.focus();
        }
      }

      function showPreviousImage() {
        if (projectImages.length < 2) {
          return;
        }

        currentImageIndex =
          (
            currentImageIndex -
            1 +
            projectImages.length
          ) % projectImages.length;

        updateLightbox();
      }

      function showNextImage() {
        if (projectImages.length < 2) {
          return;
        }

        currentImageIndex =
          (currentImageIndex + 1) %
          projectImages.length;

        updateLightbox();
      }

      closeButton?.addEventListener(
        "click",
        closeLightbox
      );

      previousButton?.addEventListener(
        "click",
        showPreviousImage
      );

      nextButton?.addEventListener(
        "click",
        showNextImage
      );

      lightbox?.addEventListener(
        "click",
        (event) => {
          if (event.target === lightbox) {
            closeLightbox();
          }
        }
      );

      document.addEventListener(
        "keydown",
        (event) => {
          if (
            !lightbox?.classList.contains("is-open")
          ) {
            return;
          }

          if (event.key === "Escape") {
            closeLightbox();
          }

          if (event.key === "ArrowLeft") {
            showPreviousImage();
          }

          if (event.key === "ArrowRight") {
            showNextImage();
          }
        }
      );
    </script>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html,
  body {
    width: 100%;
    min-height: 100%;
    margin: 0;
    padding: 0;
  }

  html {
    background: #fff;
  }

  body {
    background: #fff;
    color: #111;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 15px;
    line-height: 1.35;
  }

  body.lightbox-active {
    overflow: hidden;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .project-page {
    width: min(1500px, calc(100% - 80px));
    margin: 0 auto;
    padding: 60px 0 120px;
  }

  .back {
    display: inline-block;
    margin-bottom: 60px;
    color: #777;
    font-size: 18px;
    line-height: 1.2;
    transition: color 180ms ease;
  }

  .back:hover {
    color: #111;
  }

  .video {
    position: relative;
    width: 100%;
    margin-bottom: 80px;
    overflow: hidden;
    background: #000;
    aspect-ratio: 16 / 9;
  }

  .video iframe {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .content {
    max-width: 900px;
  }

  .project-header {
    margin-bottom: 60px;
  }

  h1 {
    margin: 0 0 20px;
    font-size: clamp(44px, 5vw, 68px);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.05em;
  }

  .meta {
    color: #777;
    font-size: 20px;
    line-height: 1.35;
  }

  .project-body p {
    margin: 0 0 28px;
    font-size: 20px;
    line-height: 1.7;
  }

  .project-body p:last-child {
    margin-bottom: 0;
  }

  .project-body a {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .project-image {
    display: block;
    width: 100%;
    height: auto;
    margin: 70px 0;
    cursor: zoom-in;
  }

  .project-image:focus-visible {
    outline: 1px solid #111;
    outline-offset: 5px;
  }

  .image-caption {
    margin-top: -55px;
    margin-bottom: 70px;
    color: #777;
    font-size: 13px;
    line-height: 1.4;
  }

  .project-navigation {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;

    margin-top: 140px;
    padding-top: 30px;

    border-top: 1px solid #ddd;
  }

  .project-navigation-side {
    min-width: 0;
  }

  .project-navigation-side a {
    display: inline-flex;
    align-items: baseline;
    gap: 12px;

    max-width: 100%;
    padding: 10px 0;

    color: #777;
    font-size: 22px;
    line-height: 1.25;

    transition: color 180ms ease;
  }

  .project-navigation-side a:hover {
    color: #111;
  }

  .project-navigation-side a:focus-visible {
    color: #111;
    outline: 1px solid #111;
    outline-offset: 6px;
  }

  .project-navigation-older {
    text-align: right;
  }

  .project-navigation-older a {
    justify-content: flex-end;
  }

  .navigation-title {
    overflow-wrap: anywhere;
  }

  .navigation-arrow {
    flex: 0 0 auto;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 48px 100px;

    visibility: hidden;
    opacity: 0;

    background: rgba(0, 0, 0, 0.95);

    transition:
      opacity 180ms ease,
      visibility 180ms ease;
  }

  .lightbox.is-open {
    visibility: visible;
    opacity: 1;
  }

  .lightbox-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    max-width: 100%;
    max-height: 100%;
  }

  .lightbox-image {
    display: block;
    max-width: 88vw;
    max-height: 84vh;
    object-fit: contain;
  }

  .lightbox-caption {
    min-height: 18px;
    margin-top: 14px;
    color: #fff;
    font-size: 13px;
    line-height: 1.4;
    text-align: center;
  }

  .lightbox-close {
    position: fixed;
    top: 20px;
    right: 25px;
    z-index: 1002;

    margin: 0;
    padding: 0;

    border: 0;
    background: transparent;
    color: #fff;

    font-family: Arial, Helvetica, sans-serif;
    font-size: 42px;
    font-weight: 300;
    line-height: 1;

    cursor: pointer;
  }

  .lightbox-arrow {
    position: fixed;
    top: 50%;
    z-index: 1002;

    padding: 20px;

    border: 0;
    background: transparent;
    color: #fff;

    font-family: Arial, Helvetica, sans-serif;
    font-size: 32px;
    font-weight: 300;
    line-height: 1;

    cursor: pointer;
    transform: translateY(-50%);
  }

  .lightbox-previous {
    left: 18px;
  }

  .lightbox-next {
    right: 18px;
  }

  .lightbox-arrow.is-hidden {
    display: none;
  }

  .lightbox-counter {
    position: fixed;
    right: 28px;
    bottom: 22px;

    color: #fff;
    font-size: 12px;
    line-height: 1.2;
  }

  @media (max-width: 900px) {
    .project-page {
      width: calc(100% - 36px);
      padding: 40px 0 80px;
    }

    .back {
      margin-bottom: 40px;
      font-size: 16px;
    }

    .video {
      margin-bottom: 55px;
    }

    .project-header {
      margin-bottom: 42px;
    }

    h1 {
      margin-bottom: 14px;
      font-size: 44px;
      line-height: 1;
    }

    .meta {
      font-size: 16px;
    }

    .project-body p {
      margin-bottom: 22px;
      font-size: 17px;
      line-height: 1.65;
    }

    .project-image {
      margin: 45px 0;
    }

    .image-caption {
      margin-top: -34px;
      margin-bottom: 45px;
      font-size: 12px;
    }

    .project-navigation {
      gap: 18px;
      margin-top: 90px;
      padding-top: 20px;
    }

    .project-navigation-side a {
      gap: 8px;
      padding: 8px 0;
      font-size: 16px;
    }

    .lightbox {
      padding: 55px 18px 48px;
    }

    .lightbox-image {
      max-width: 100%;
      max-height: 77vh;
    }

    .lightbox-close {
      top: 14px;
      right: 17px;
      font-size: 36px;
    }

    .lightbox-arrow {
      top: auto;
      bottom: 6px;
      padding: 14px;
      font-size: 25px;
      transform: none;
    }

    .lightbox-previous {
      left: 8px;
    }

    .lightbox-next {
      right: 8px;
    }

    .lightbox-counter {
      right: 50%;
      bottom: 21px;
      transform: translateX(50%);
    }

    .lightbox-caption {
      max-width: calc(100vw - 36px);
      margin-top: 10px;
      font-size: 12px;
    }
  }
</style>