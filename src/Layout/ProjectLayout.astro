---
interface Props {
  title: string;
  year?: string | number;
  medium?: string;
  vimeo?: string;
  description?: string;
}

const {
  title,
  year,
  medium,
  vimeo,
  description = `${title} — Juho Lee`,
} = Astro.props;

const meta = [year, medium].filter(Boolean).join(" · ");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="description"
      content={description}
    />

    <title>{title} | Juho Lee</title>

    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon.png"
    />
  </head>

  <body>
    <main class="project-page">
      <a class="back" href="/work">
        ← Back
      </a>

      {
        vimeo && (
          <div class="video">
            <iframe
              src={vimeo}
              title={`${title} video`}
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen
            />
          </div>
        )
      }

      <article class="content">
        <header class="project-header">
          <h1>{title}</h1>

          {
            meta && (
              <div class="meta">
                {meta}
              </div>
            )
          }
        </header>

        <div class="project-body">
          <slot />
        </div>
      </article>
    </main>

    <div
      class="lightbox"
      id="lightbox"
      aria-hidden="true"
      role="dialog"
      aria-modal="true"
      aria-label="Image preview"
    >
      <button
        class="lightbox-close"
        type="button"
        aria-label="Close image"
      >
        ×
      </button>

      <img
        class="lightbox-image"
        src=""
        alt=""
      />

      <div class="lightbox-caption"></div>
    </div>

    <script>
      const lightbox = document.querySelector("#lightbox");
      const lightboxImage =
        lightbox?.querySelector(".lightbox-image");
      const lightboxCaption =
        lightbox?.querySelector(".lightbox-caption");
      const closeButton =
        lightbox?.querySelector(".lightbox-close");

      const projectImages =
        document.querySelectorAll(".project-image");

      function openLightbox(image) {
        if (
          !lightbox ||
          !(lightboxImage instanceof HTMLImageElement) ||
          !(image instanceof HTMLImageElement)
        ) {
          return;
        }

        lightboxImage.src = image.currentSrc || image.src;
        lightboxImage.alt = image.alt || "";

        if (lightboxCaption) {
          lightboxCaption.textContent =
            image.dataset.caption || image.alt || "";
        }

        lightbox.classList.add("is-open");
        lightbox.setAttribute("aria-hidden", "false");
        document.body.classList.add("lightbox-active");
        closeButton?.focus();
      }

      function closeLightbox() {
        if (
          !lightbox ||
          !(lightboxImage instanceof HTMLImageElement)
        ) {
          return;
        }

        lightbox.classList.remove("is-open");
        lightbox.setAttribute("aria-hidden", "true");
        document.body.classList.remove("lightbox-active");

        window.setTimeout(() => {
          lightboxImage.src = "";
          lightboxImage.alt = "";

          if (lightboxCaption) {
            lightboxCaption.textContent = "";
          }
        }, 200);
      }

      projectImages.forEach((image) => {
        image.setAttribute("tabindex", "0");
        image.setAttribute("role", "button");

        image.addEventListener("click", () => {
          openLightbox(image);
        });

        image.addEventListener("keydown", (event) => {
          if (
            event.key === "Enter" ||
            event.key === " "
          ) {
            event.preventDefault();
            openLightbox(image);
          }
        });
      });

      closeButton?.addEventListener("click", closeLightbox);

      lightbox?.addEventListener("click", (event) => {
        if (
          event.target === lightbox ||
          event.target === lightboxImage
        ) {
          closeLightbox();
        }
      });

      document.addEventListener("keydown", (event) => {
        if (
          event.key === "Escape" &&
          lightbox?.classList.contains("is-open")
        ) {
          closeLightbox();
        }
      });
    </script>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html,
  body {
    width: 100%;
    min-height: 100%;
    margin: 0;
    padding: 0;
  }

  html {
    background: #fff;
  }

  body {
    background: #fff;
    color: #111;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 15px;
    line-height: 1.35;
  }

  body.lightbox-active {
    overflow: hidden;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .project-page {
    width: min(1500px, calc(100% - 80px));
    margin: 0 auto;
    padding: 60px 0 120px;
  }

  .back {
    display: inline-block;
    margin-bottom: 60px;
    color: #777;
    font-size: 18px;
    line-height: 1.2;
    transition: color 160ms ease;
  }

  .back:hover {
    color: #111;
  }

  .video {
    position: relative;
    width: 100%;
    margin-bottom: 80px;
    overflow: hidden;
    background: #000;
    aspect-ratio: 16 / 9;
  }

  .video iframe {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .content {
    max-width: 900px;
  }

  .project-header {
    margin-bottom: 60px;
  }

  h1 {
    margin: 0 0 20px;
    font-size: clamp(44px, 5vw, 68px);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.05em;
  }

  .meta {
    color: #777;
    font-size: 20px;
    line-height: 1.35;
  }

  .project-body p {
    margin: 0 0 28px;
    font-size: 20px;
    line-height: 1.7;
  }

  .project-body p:last-child {
    margin-bottom: 0;
  }

  .project-body a {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .project-image {
    display: block;
    width: 100%;
    height: auto;
    margin: 70px 0;
    cursor: zoom-in;
  }

  .project-image:first-child {
    margin-top: 0;
  }

  .project-image:last-child {
    margin-bottom: 0;
  }

  .project-image:focus-visible {
    outline: 1px solid #111;
    outline-offset: 5px;
  }

  .image-caption {
    margin-top: -55px;
    margin-bottom: 70px;
    color: #777;
    font-size: 13px;
    line-height: 1.4;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 40px;

    visibility: hidden;
    opacity: 0;
    background: rgba(0, 0, 0, 0.94);

    transition:
      opacity 180ms ease,
      visibility 180ms ease;
  }

  .lightbox.is-open {
    visibility: visible;
    opacity: 1;
  }

  .lightbox-image {
    display: block;
    max-width: 94vw;
    max-height: 90vh;
    object-fit: contain;
    cursor: zoom-out;
  }

  .lightbox-close {
    position: fixed;
    top: 20px;
    right: 25px;
    z-index: 1001;

    margin: 0;
    padding: 0;

    border: 0;
    background: transparent;
    color: #fff;

    font-family: Arial, Helvetica, sans-serif;
    font-size: 42px;
    font-weight: 300;
    line-height: 1;

    cursor: pointer;
  }

  .lightbox-caption {
    position: fixed;
    right: 30px;
    bottom: 22px;
    left: 30px;

    color: #fff;
    font-size: 13px;
    line-height: 1.4;
    text-align: center;
  }

  @media (max-width: 900px) {
    .project-page {
      width: calc(100% - 36px);
      padding: 40px 0 80px;
    }

    .back {
      margin-bottom: 40px;
      font-size: 16px;
    }

    .video {
      margin-bottom: 55px;
    }

    .project-header {
      margin-bottom: 42px;
    }

    h1 {
      margin-bottom: 14px;
      font-size: 44px;
      line-height: 1;
    }

    .meta {
      font-size: 16px;
    }

    .project-body p {
      margin-bottom: 22px;
      font-size: 17px;
      line-height: 1.65;
    }

    .project-image {
      margin: 45px 0;
    }

    .image-caption {
      margin-top: -34px;
      margin-bottom: 45px;
      font-size: 12px;
    }

    .lightbox {
      padding: 18px;
    }

    .lightbox-image {
      max-width: 100%;
      max-height: 86vh;
    }

    .lightbox-close {
      top: 14px;
      right: 17px;
      font-size: 36px;
    }

    .lightbox-caption {
      right: 18px;
      bottom: 14px;
      left: 18px;
      font-size: 12px;
    }
  }
</style>