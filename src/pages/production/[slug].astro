---
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

import {
  productionProjects,
  type ProductionProject,
} from "../../data/productionProjects";

import {
  createProductionToken,
  verifyProductionToken,
} from "../../lib/productionAuth";

export const prerender = false;

const slug = Astro.params.slug ?? "";

const project = productionProjects.find(
  (item) => item.slug === slug
) as ProductionProject | undefined;

if (!project) {
  return Astro.redirect("/production");
}

const password =
  import.meta.env[project.passwordEnv] ?? "";

const authSecret =
  import.meta.env.PRODUCTION_AUTH_SECRET ?? "";

const cookieName = `production_access_${project.slug}`;

let errorMessage = "";

let isAuthorized = await verifyProductionToken(
  project.slug,
  Astro.cookies.get(cookieName)?.value,
  authSecret
);

if (
  Astro.request.method === "POST" &&
  !isAuthorized
) {
  const formData = await Astro.request.formData();

  const enteredPassword = String(
    formData.get("password") ?? ""
  );

  if (
    password &&
    authSecret &&
    enteredPassword === password
  ) {
    const token = await createProductionToken(
      project.slug,
      authSecret
    );

    Astro.cookies.set(cookieName, token, {
      httpOnly: true,
      secure: import.meta.env.PROD,
      sameSite: "strict",
      path: `/production/${project.slug}`,
      maxAge: 60 * 60 * 24 * 7,
    });

    isAuthorized = true;
  } else {
    errorMessage = "Incorrect password.";
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta name="robots" content="noindex, nofollow" />

    <title>{project.title} — Production — Juho Lee</title>

    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon.png"
    />
  </head>

  <body>
    <Header />

    {
      !isAuthorized ? (
        <main class="login-page">
          <section class="login-panel">
            <a
              class="back-link"
              href="/production"
            >
              ← Production
            </a>

            <span class="internal-label">
              Internal
            </span>

            <h1>{project.title}</h1>

            <p class="login-description">
              This project is available only to
              authorized collaborators.
            </p>

            <form method="POST">
              <label for="password">
                Password
              </label>

              <input
                id="password"
                name="password"
                type="password"
                autocomplete="current-password"
                autofocus
                required
              />

              {errorMessage && (
                <p class="error-message">
                  {errorMessage}
                </p>
              )}

              <button type="submit">
                Enter
              </button>
            </form>
          </section>
        </main>
      ) : (
        <main class="project-page">
          <header class="project-header">
            <div>
              <a
                class="back-link"
                href="/production"
              >
                ← Production
              </a>

              <span class="internal-label">
                Internal
              </span>

              <h1>{project.title}</h1>

              <p>{project.description}</p>
            </div>

            <span class="year">
              {project.year}
            </span>
          </header>

          <section class="status-section">
            <div class="section-heading">
              <h2>Status</h2>
              <span>In production</span>
            </div>

            <div class="progress-bar">
              <div class="progress-value"></div>
            </div>

            <p class="updated">
              Last updated: July 2026
            </p>
          </section>

          <section class="content-section">
            <h2>Overview</h2>

            <p>
              Add a short project description,
              production brief, responsibilities,
              schedule, and current goals here.
            </p>
          </section>

          <section class="content-section">
            <h2>Work in Progress</h2>

            <div class="media-grid">
              <div class="media-placeholder">
                Image or video
              </div>

              <div class="media-placeholder">
                Image or video
              </div>

              <div class="media-placeholder">
                Image or video
              </div>
            </div>
          </section>

          <section class="content-section">
            <h2>Notes</h2>

            <article class="note">
              <time>28 July 2026</time>

              <p>
                Add the newest production update here.
              </p>
            </article>

            <article class="note">
              <time>25 July 2026</time>

              <p>
                Add an earlier update or feedback note
                here.
              </p>
            </article>
          </section>

          <section class="content-section">
            <h2>Downloads</h2>

            <div class="download-list">
              <span>Files will be added here.</span>
            </div>
          </section>
        </main>
      )
    }

    <div class="footer-container">
      <Footer />
    </div>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html),
  :global(body) {
    width: 100%;
    min-height: 100%;
    margin: 0;
  }

  :global(body) {
    background: #fff;
    color: #111;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 15px;
    line-height: 1.35;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .login-page,
  .project-page {
    width: min(1120px, calc(100% - 270px));
    min-height: 70vh;
    margin-left: 230px;
    padding: 47px 0 100px;
  }

  .login-page {
    display: flex;
    align-items: center;
  }

  .login-panel {
    width: 100%;
    max-width: 420px;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 40px;
    color: #666;
    font-size: 12px;
  }

  .back-link:hover {
    color: #111;
  }

  .internal-label {
    display: table;
    margin-bottom: 12px;
    padding: 4px 7px;
    border: 1px solid #111;
    font-size: 10px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: 38px;
    font-weight: 500;
    line-height: 1;
  }

  .login-description {
    max-width: 350px;
    margin: 16px 0 38px;
    color: #555;
  }

  form {
    width: 100%;
  }

  label {
    display: block;
    margin-bottom: 8px;
    font-size: 12px;
  }

  input {
    display: block;
    width: 100%;
    height: 44px;
    padding: 9px 11px;
    border: 1px solid #aaa;
    border-radius: 0;
    outline: none;
    background: #fff;
    color: #111;
    font: inherit;
  }

  input:focus {
    border-color: #111;
  }

  button {
    margin-top: 12px;
    padding: 11px 20px;
    border: 1px solid #111;
    border-radius: 0;
    background: #111;
    color: #fff;
    font: inherit;
    cursor: pointer;
  }

  button:hover {
    background: #fff;
    color: #111;
  }

  .error-message {
    margin: 9px 0 0;
    color: #a00000;
    font-size: 12px;
  }

  .project-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;
    padding-bottom: 34px;
    border-bottom: 1px solid #ccc;
  }

  .project-header .back-link {
    display: block;
  }

  .project-header p {
    max-width: 580px;
    margin: 14px 0 0;
    color: #555;
  }

  .year {
    font-size: 12px;
  }

  .status-section,
  .content-section {
    padding: 50px 0;
    border-bottom: 1px solid #ccc;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    gap: 20px;
  }

  h2 {
    margin: 0 0 22px;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .section-heading span {
    font-size: 12px;
  }

  .progress-bar {
    width: 100%;
    height: 6px;
    overflow: hidden;
    background: #ddd;
  }

  .progress-value {
    width: 70%;
    height: 100%;
    background: #111;
  }

  .updated {
    margin: 9px 0 0;
    color: #777;
    font-size: 11px;
  }

  .content-section > p {
    max-width: 680px;
    margin: 0;
  }

  .media-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
  }

  .media-placeholder {
    display: grid;
    aspect-ratio: 16 / 9;
    place-items: center;
    background: #eee;
    color: #888;
    font-size: 12px;
  }

  .note {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 30px;
    padding: 15px 0;
    border-top: 1px solid #ddd;
  }

  .note:last-child {
    border-bottom: 1px solid #ddd;
  }

  .note time {
    color: #666;
    font-size: 12px;
  }

  .note p {
    margin: 0;
  }

  .download-list {
    padding: 20px;
    background: #eee;
    color: #777;
    font-size: 12px;
  }

  .footer-container {
    width: min(1120px, calc(100% - 270px));
    margin-left: 230px;
    padding-bottom: 40px;
  }

  @media (max-width: 760px) {
    .login-page,
    .project-page {
      width: auto;
      min-height: 70vh;
      margin-left: 0;
      padding: 80px 18px;
    }

    .login-page {
      align-items: flex-start;
    }

    h1 {
      font-size: 32px;
    }

    .project-header {
      align-items: flex-start;
    }

    .media-grid {
      grid-template-columns: 1fr;
    }

    .note {
      grid-template-columns: 1fr;
      gap: 7px;
    }

    .footer-container {
      width: auto;
      margin-left: 0;
      padding: 0 18px 30px;
    }
  }
</style>