</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #fff;
    color: #111;
    font-family: Arial, Helvetica, sans-serif;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  header,
  main {
    width: min(1320px, calc(100% - 64px));
    margin: 0 auto;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 26px 0;
  }

  .name {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  nav {
    display: flex;
    gap: 26px;
  }

  nav a {
    font-size: 16px;
    font-weight: 400;
  }

  nav a:hover,
  .email:hover,
  footer a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  main {
    min-height: calc(100vh - 77px);
    display: flex;
    flex-direction: column;
    padding-top: 56px;
    padding-bottom: 32px;
  }

  section {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 34px;
  }

  h1 {
    margin: 0;
    font-size: 15px;
    font-weight: 700;
  }

  .contact-info {
    font-size: 15px;
    line-height: 1.45;
  }

  .contact-info p {
    margin: 5px 0 0;
    opacity: 0.55;
  }

  footer {
    margin-top: auto;
    padding-top: 80px;
  }

  footer a {
    font-size: 11px;
  }

  @media (max-width: 650px) {
    header,
    main {
      width: calc(100% - 32px);
    }

    nav {
      gap: 14px;
    }

    nav a {
      font-size: 14px;
    }

    main {
      padding-top: 36px;
    }

    section {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>