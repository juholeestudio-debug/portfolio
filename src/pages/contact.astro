---
import Header from "../components/Header.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="description"
      content="Contact Juho Lee"
    />

    <title>Contact — Juho Lee</title>

    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon.png"
    />
  </head>

  <body>
    <main class="contact-page">
      <Header mobileFixed />

      <section class="contact-content">
        <div class="contact-animation">
          <video
            autoplay
            muted
            loop
            playsinline
            preload="auto"
          >
            <source
              src="/video/sori.mp4"
              type="video/mp4"
            />
          </video>
        </div>

        <div class="contact-item">
          <div class="label">Email</div>

          <a href="mailto:juholee.studio@gmail.com">
            juholee.studio@gmail.com
          </a>
        </div>

        <div class="contact-item">
          <div class="label">Instagram</div>

          <a
            href="https://www.instagram.com/juho_2d/"
            target="_blank"
            rel="noopener noreferrer"
          >
            @juho_2d
          </a>
        </div>
      </section>

      <div class="legal-links">
        <a href="/impressum">Impressum</a>
        <a href="/privacy">Privacy Policy</a>
      </div>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html),
  :global(body) {
    width: 100%;
    min-height: 100%;
    margin: 0;
  }

  :global(body) {
    background: #fff;
    color: #111;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 15px;
    line-height: 1.35;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .contact-page {
    position: relative;
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    background: #fff;
  }

  .contact-content {
    padding-top: 190px;
    padding-right: 32px;
    padding-bottom: 120px;
    padding-left: 32px;
  }

  .contact-animation {
    margin-bottom: 48px;
  }

  .contact-animation video {
    display: block;
    width: 180px;
    height: auto;
  }

  .contact-item {
    margin-bottom: 34px;
  }

  .label {
    margin-bottom: 5px;
    color: #777;
    font-size: 12px;
  }

  .contact-content a {
    font-size: 15px;
    font-weight: 400;
    line-height: 1.35;
  }

  .contact-content a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .legal-links {
    position: fixed;
    right: 32px;
    bottom: 28px;
    z-index: 100;

    display: flex;
    align-items: center;
    gap: 20px;

    padding: 5px 7px;

    background: #fff;
    color: #111;

    font-size: 12px;
    font-weight: 400;
    line-height: 1.2;
  }

  .legal-links a {
    display: block;
  }

  .legal-links a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (max-width: 760px) {
    .contact-content {
      padding-top: 130px;
      padding-right: 18px;
      padding-bottom: 100px;
      padding-left: 18px;
    }

    .contact-animation {
      margin-bottom: 36px;
    }

    .contact-animation video {
      width: 150px;
    }

    .contact-item {
      margin-bottom: 28px;
    }

    .contact-content a {
      font-size: 14px;
    }

    .legal-links {
      right: 18px;
      bottom: 18px;
      gap: 14px;
      padding: 5px 7px;
      font-size: 11px;
    }
  }
</style>