<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta
      name="description"
      content="Contact Juho Lee"
    />

    <title>Contact — Juho Lee</title>
  </head>

  <body>
    <header>
      <a href="/" class="name">Juho Lee</a>

      <nav>
        <a href="/work">Work</a>
        <a href="/cv">CV</a>
        <a href="/contact">Contact</a>
      </nav>
