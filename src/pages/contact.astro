---
import Header from "../components/Header.astro";

const turnstileSiteKey =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="description"
      content="Contact Juho Lee"
    />

    <title>Contact — Juho Lee</title>

    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon.png"
    />

    <script
      is:inline
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    ></script>
  </head>

  <body>
    <main class="contact-page">
      <Header mobileFixed />

      <section class="contact-content">

        <!-- LEFT CONTACT -->

        <div class="contact-left">

          <div class="contact-animation">
            <video
              autoplay
              muted
              loop
              playsinline
              preload="auto"
            >
              <source
                src="/video/sori.mp4"
                type="video/mp4"
              />
            </video>
          </div>

          <div class="contact-item">
            <div class="label">
              Email
            </div>

            <a href="mailto:juholee.studio@gmail.com">
              juholee.studio@gmail.com
            </a>
          </div>

          <div class="contact-item">
            <div class="label">
              Instagram
            </div>

            <a
              href="https://www.instagram.com/juho_2d/"
              target="_blank"
              rel="noopener noreferrer"
            >
              @juho_2d
            </a>
          </div>

        </div>


        <!-- SEND A MESSAGE -->

        <div
          id="inquiry"
          class="inquiry"
        >

          <div
            id="inquiry-title"
            class="inquiry-title"
          >
            Send a message
          </div>


          <form
            id="contact-form"
            class="inquiry-form"
          >

            <div class="form-field">
              <label for="name">
                Name
              </label>

              <input
                id="name"
                name="name"
                type="text"
                autocomplete="name"
                maxlength="100"
                required
              />
            </div>


            <div class="form-field">
              <label for="email">
                Email
              </label>

              <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                maxlength="200"
                required
              />
            </div>


            <div class="form-field">
              <label for="message">
                Message
              </label>

              <textarea
                id="message"
                name="message"
                rows="5"
                maxlength="3000"
                required
              ></textarea>
            </div>


            <!-- HONEYPOT -->

            <div
              class="hp-field"
              aria-hidden="true"
            >
              <label for="website">
                Website
              </label>

              <input
                id="website"
                name="website"
                type="text"
                tabindex="-1"
                autocomplete="off"
              />
            </div>


            <!-- TURNSTILE -->

            <div class="turnstile-wrapper">
              <div
                class="cf-turnstile"
                data-sitekey={turnstileSiteKey}
                data-theme="light"
                data-size="flexible"
              ></div>
            </div>


            <div class="form-footer">

              <button
                id="send-button"
                class="send-button"
                type="submit"
              >
                Send
              </button>

              <div
                id="form-status"
                class="form-status"
                role="status"
                aria-live="polite"
              ></div>

            </div>

          </form>


          <!-- SUCCESS ANIMATION -->

          <div
            id="success-view"
            class="success-view"
          >

            <video
              id="success-video"
              class="success-video"
              muted
              playsinline
              preload="auto"
            >
              <source
                src="/video/message-sent.mp4"
                type="video/mp4"
              />
            </video>

            <div
              id="success-message"
              class="success-message"
              aria-live="polite"
            >
              Message sent.
            </div>

          </div>

        </div>

      </section>


      <!-- LEGAL -->

      <div class="legal-links">
        <a href="/impressum">
          Impressum
        </a>

        <a href="/privacy">
          Privacy Policy
        </a>
      </div>

    </main>


    <script>
      const form =
        document.querySelector<HTMLFormElement>(
          "#contact-form"
        );

      const inquiry =
        document.querySelector<HTMLDivElement>(
          "#inquiry"
        );

      const inquiryTitle =
        document.querySelector<HTMLDivElement>(
          "#inquiry-title"
        );

      const sendButton =
        document.querySelector<HTMLButtonElement>(
          "#send-button"
        );

      const formStatus =
        document.querySelector<HTMLDivElement>(
          "#form-status"
        );

      const successView =
        document.querySelector<HTMLDivElement>(
          "#success-view"
        );

      const successVideo =
        document.querySelector<HTMLVideoElement>(
          "#success-video"
        );

      const successMessage =
        document.querySelector<HTMLDivElement>(
          "#success-message"
        );


      const startedAt =
        Date.now();


      const getTurnstile = () => {
        return (
          window as Window & {
            turnstile?: {
              reset: () => void;
            };
          }
        ).turnstile;
      };


      const restoreForm = () => {

        if (
          !form ||
          !inquiry ||
          !inquiryTitle ||
          !successView ||
          !successMessage
        ) {
          return;
        }


        successView.classList.remove(
          "is-active"
        );


        successMessage.classList.remove(
          "is-visible"
        );


        inquiryTitle.style.display = "";

        form.style.display = "";


        inquiry.style.height = "";


        if (formStatus) {
          formStatus.textContent = "";
        }
      };


      const playSuccessAnimation =
        async () => {

          if (
            !form ||
            !inquiry ||
            !inquiryTitle ||
            !successView ||
            !successVideo ||
            !successMessage
          ) {
            return;
          }


          /*
            Keep the outer message box
            at the same height while
            the success animation plays.
          */

          const currentHeight =
            inquiry.offsetHeight;


          inquiry.style.height =
            `${currentHeight}px`;


          inquiryTitle.style.display =
            "none";


          form.style.display =
            "none";


          successView.classList.add(
            "is-active"
          );


          successMessage.classList.remove(
            "is-visible"
          );


          successVideo.pause();

          successVideo.currentTime = 0;


          const showMessage = () => {

            successMessage.classList.add(
              "is-visible"
            );


            window.setTimeout(
              () => {
                restoreForm();
              },
              1800
            );
          };


          successVideo.onended = () => {
            showMessage();
          };


          try {

            await successVideo.play();

          } catch (error) {

            console.error(
              "Success animation could not play:",
              error
            );


            showMessage();
          }
        };


      if (
        form &&
        sendButton &&
        formStatus
      ) {

        form.addEventListener(
          "submit",
          async (event) => {

            event.preventDefault();


            if (!form.reportValidity()) {
              return;
            }


            const formData =
              new FormData(form);


            const name =
              String(
                formData.get("name") || ""
              ).trim();


            const email =
              String(
                formData.get("email") || ""
              ).trim();


            const message =
              String(
                formData.get("message") || ""
              ).trim();


            const website =
              String(
                formData.get("website") || ""
              ).trim();


            const turnstileInput =
              document.querySelector<
                HTMLInputElement
              >(
                '[name="cf-turnstile-response"]'
              );


            const turnstileToken =
              turnstileInput?.value || "";


            if (!turnstileToken) {

              formStatus.textContent =
                "Please complete verification.";

              return;
            }


            sendButton.disabled = true;


            sendButton.textContent =
              "Sending…";


            formStatus.textContent = "";


            try {

              const response =
                await fetch(
                  "/api/contact",
                  {
                    method: "POST",

                    headers: {
                      "Content-Type":
                        "application/json",
                    },

                    body: JSON.stringify({
                      name,
                      email,
                      message,
                      website,
                      startedAt,
                      turnstileToken,
                    }),
                  }
                );


              const result =
                await response.json();


              if (!response.ok) {

                throw new Error(
                  result.error ||
                  "Message could not be sent."
                );
              }


              form.reset();


              const turnstile =
                getTurnstile();


              if (turnstile) {
                turnstile.reset();
              }


              await playSuccessAnimation();


            } catch (error) {

              console.error(error);


              formStatus.textContent =
                error instanceof Error
                  ? error.message
                  : "Message could not be sent.";


            } finally {

              sendButton.disabled = false;


              sendButton.textContent =
                "Send";

            }
          }
        );
      }
    </script>

  </body>
</html>


<style>

  :global(*) {
    box-sizing: border-box;
  }


  :global(html),
  :global(body) {
    width: 100%;
    min-height: 100%;
    margin: 0;
  }


  :global(body) {
    background: #fff;
    color: #111;

    font-family:
      Arial,
      Helvetica,
      sans-serif;

    font-size: 15px;
    line-height: 1.35;
  }


  a {
    color: inherit;
    text-decoration: none;
  }



  /* PAGE */

  .contact-page {
    position: relative;

    width: 100%;

    min-height: 100vh;
    min-height: 100dvh;

    background: #fff;
  }


  .contact-content {
    position: relative;

    min-height: 100vh;

    padding-top: 230px;
    padding-right: 32px;
    padding-bottom: 150px;
    padding-left: 32px;
  }



  /* LEFT CONTACT */

  .contact-left {
    width: 220px;
  }


  .contact-animation {
    margin-bottom: 48px;
  }


  .contact-animation video {
    display: block;

    width: 180px;
    height: auto;
  }


  .contact-item {
    margin-bottom: 34px;
  }


  .label {
    margin-bottom: 5px;

    color: #777;

    font-size: 12px;
  }


  .contact-content a {
    font-size: 15px;
    font-weight: 400;
    line-height: 1.35;
  }


  .contact-content a:hover {
    text-decoration: underline;

    text-underline-offset: 4px;
  }



  /* SEND A MESSAGE BOX */

  .inquiry {
    position: absolute;

    top: 80px;
    left: 30vw;

    width: 520px;

    max-width: calc(
      100vw - 30vw - 64px
    );

    padding: 30px;

    border: 1px solid #777;

    border-radius: 0;

    background: #fff;
  }


  .inquiry-title {
    margin-bottom: 36px;

    color: #111;

    font-size: 15px;

    font-weight: 500;

    line-height: 1.35;
  }



  /* FORM */

  .inquiry-form {
    display: flex;

    flex-direction: column;

    gap: 30px;
  }


  .form-field {
    display: flex;

    flex-direction: column;
  }


  .form-field label {
    margin-bottom: 8px;

    color: #777;

    font-size: 12px;

    line-height: 1.35;
  }


  .form-field input,
  .form-field textarea {
    display: block;

    width: 100%;

    padding: 4px 0 8px;

    border: 0;

    border-bottom:
      1px solid #bbb;

    border-radius: 0;

    outline: none;

    background: transparent;

    color: #111;

    font-family:
      Arial,
      Helvetica,
      sans-serif;

    font-size: 15px;

    line-height: 1.35;

    appearance: none;

    -webkit-appearance: none;
  }


  .form-field textarea {
    min-height: 110px;

    resize: none;
  }


  .form-field input:focus,
  .form-field textarea:focus {
    border-bottom-color: #111;
  }



  /* HONEYPOT */

  .hp-field {
    position: absolute !important;

    left: -9999px !important;

    width: 1px;
    height: 1px;

    overflow: hidden;

    opacity: 0;

    pointer-events: none;
  }



  /* TURNSTILE */

  .turnstile-wrapper {
    width: 100%;

    min-height: 65px;
  }



  /* FORM FOOTER */

  .form-footer {
    display: flex;

    align-items: center;

    gap: 18px;
  }



  /* SEND BUTTON */

  .send-button {
    flex: 0 0 auto;

    margin: 0;

    padding: 0;

    border: 0;

    background: transparent;

    color: #111;

    font-family:
      Arial,
      Helvetica,
      sans-serif;

    font-size: 15px;

    font-weight: 400;

    line-height: 1.35;

    cursor: pointer;
  }


  .send-button:hover {
    text-decoration: underline;

    text-underline-offset: 4px;
  }


  .send-button:disabled {
    color: #777;

    cursor: default;

    text-decoration: none;
  }



  /* STATUS */

  .form-status {
    min-height: 20px;

    color: #777;

    font-size: 12px;

    line-height: 1.35;
  }



  /* SUCCESS ANIMATION */

  .success-view {
    position: absolute;

    inset: 8px;

    display: none;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    text-align: center;

    overflow: hidden;
  }


  .success-view.is-active {
    display: flex;
  }


  .success-video {
    display: block;

    width: 100%;
    height: auto;

    max-width: none;

    aspect-ratio: 1 / 1;

    object-fit: contain;

    background: transparent;
  }


  .success-message {
    position: absolute;

    left: 0;
    right: 0;

    bottom: 18px;

    color: #111;

    font-size: 13px;

    font-weight: 400;

    line-height: 1.35;

    opacity: 0;

    transform:
      translateY(3px);

    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }


  .success-message.is-visible {
    opacity: 1;

    transform:
      translateY(0);
  }



  /* LEGAL */

  .legal-links {
    position: fixed;

    right: 32px;

    bottom: 28px;

    z-index: 100;

    display: flex;

    align-items: center;

    gap: 20px;

    padding: 5px 7px;

    background: #fff;

    color: #111;

    font-size: 12px;

    font-weight: 400;

    line-height: 1.2;
  }


  .legal-links a {
    display: block;
  }


  .legal-links a:hover {
    text-decoration: underline;

    text-underline-offset: 4px;
  }



  /* TABLET */

  @media (max-width: 1050px) {

    .inquiry {
      left: 34vw;

      width: 460px;

      max-width: calc(
        100vw - 34vw - 40px
      );
    }

  }



  /* MOBILE */

  @media (max-width: 760px) {

    .contact-content {
      min-height: auto;

      padding-top: 130px;

      padding-right: 18px;

      padding-bottom: 110px;

      padding-left: 18px;
    }


    .contact-left {
      width: 100%;
    }


    .contact-animation {
      margin-bottom: 36px;
    }


    .contact-animation video {
      width: 150px;
    }


    .contact-item {
      margin-bottom: 28px;
    }


    .contact-content a {
      font-size: 14px;
    }



    /* MESSAGE BOX */

    .inquiry {
      position: relative;

      top: auto;

      left: auto;

      width: 100%;

      max-width: none;

      margin-top: 58px;

      padding: 24px 20px 26px;

      border: 1px solid #777;
    }


    .inquiry-title {
      margin-bottom: 32px;

      font-size: 14px;
    }


    .inquiry-form {
      gap: 26px;
    }


    .form-field input,
    .form-field textarea {
      font-size: 14px;
    }


    .form-field textarea {
      min-height: 100px;
    }


    .send-button {
      font-size: 14px;
    }


    .form-footer {
      align-items: flex-start;

      flex-direction: column;

      gap: 8px;
    }



    /* SUCCESS */

    .success-view {
      inset: 6px;
    }


    .success-video {
      width: 100%;

      max-width: 100%;

      height: auto;

      aspect-ratio: 1 / 1;

      object-fit: contain;
    }


    .success-message {
      bottom: 14px;

      font-size: 12px;
    }



    /* LEGAL */

    .legal-links {
      right: 18px;

      bottom: 18px;

      gap: 14px;

      padding: 5px 7px;

      font-size: 11px;
    }

  }

</style>