---
import Header from "../components/Header.astro";

const heroImage = "/images/einsteigen-cover.webp";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="description"
      content="Juho Lee — Animation and Media Artist"
    />

    <title>Juho Lee</title>

    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon.png"
    />
  </head>

  <body>
    <main class="home">
      <img
        class="hero-image"
        src={heroImage}
        alt=""
        draggable="false"
      />

      <Header home />

      <div class="legal-links">
        <a href="/impressum">Impressum</a>
        <a href="/privacy">Privacy Policy</a>
      </div>
    </main>

    <script>
      const hero = document.querySelector(".hero-image");

      if (hero instanceof HTMLImageElement) {
        let currentY = 0;
        let targetY = 0;

        let currentX = 60;
        let targetX = 60;

        let touchStartX = 0;
        let touchStartY = 0;

        let touchPreviousX = 0;
        let touchPreviousY = 0;

        const clamp = (value, min, max) =>
          Math.max(min, Math.min(max, value));

        const isPhonePortrait = () =>
          window.innerWidth <= 760 &&
          window.innerHeight > window.innerWidth;

        /*
          DESKTOP / LAPTOP
          휠 또는 트랙패드 → 이미지 위아래 이동
        */
        window.addEventListener(
          "wheel",
          (event) => {
            if (window.matchMedia("(pointer: coarse)").matches) {
              return;
            }

            event.preventDefault();

            targetY += event.deltaY * 0.03;
            targetY = clamp(targetY, 0, 100);
          },
          { passive: false }
        );

        /*
          TOUCH START
        */
        window.addEventListener(
          "touchstart",
          (event) => {
            const touch = event.touches[0];

            touchStartX = touch.clientX;
            touchStartY = touch.clientY;

            touchPreviousX = touch.clientX;
            touchPreviousY = touch.clientY;
          },
          { passive: true }
        );

        /*
          TOUCH MOVE
        */
        window.addEventListener(
          "touchmove",
          (event) => {
            if (event.touches.length !== 1) return;

            const touch = event.touches[0];

            const deltaX =
              touch.clientX - touchPreviousX;

            const deltaY =
              touch.clientY - touchPreviousY;

            /*
              PHONE PORTRAIT
              좌우 드래그 → 이미지 좌우 이동
            */
            if (isPhonePortrait()) {
              event.preventDefault();

              targetX -= deltaX * 0.12;
              targetX = clamp(targetX, 0, 100);
            }

            /*
              TABLET / IPAD / LANDSCAPE TOUCH
              위아래 드래그 → 이미지 위아래 이동
            */
            else {
              event.preventDefault();

              targetY -= deltaY * 0.12;
              targetY = clamp(targetY, 0, 100);
            }

            touchPreviousX = touch.clientX;
            touchPreviousY = touch.clientY;
          },
          { passive: false }
        );

        /*
          화면 크기가 바뀌었을 때
        */
        window.addEventListener("resize", () => {
          if (!isPhonePortrait()) {
            targetX = 50;
            currentX = 50;
          } else if (targetX === 50) {
            targetX = 60;
            currentX = 60;
          }
        });

        /*
          부드러운 이동
        */
        const animate = () => {
          currentY +=
            (targetY - currentY) * 0.08;

          currentX +=
            (targetX - currentX) * 0.08;

          const xPosition =
            isPhonePortrait()
              ? currentX
              : 50;

          hero.style.objectPosition =
            `${xPosition}% ${currentY}%`;

          requestAnimationFrame(animate);
        };

        animate();
      }
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html),
  :global(body) {
    width: 100%;
    height: 100%;
    margin: 0;
  }

  :global(body) {
    overflow: hidden;
    overscroll-behavior: none;

    background: #fff;
    color: #111;

    font-family: Arial, Helvetica, sans-serif;
    font-size: 15px;
    line-height: 1.35;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .home {
    position: relative;

    width: 100%;
    height: 100vh;
    height: 100dvh;

    overflow: hidden;

    background: #fff;

    /*
      모바일 Safari에서 페이지 자체가
      튕기거나 움직이는 것을 방지
    */
    touch-action: none;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    z-index: 0;

    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;

    /*
      데스크톱 시작 위치:
      이미지의 가장 위
    */
    object-position: center 0%;

    user-select: none;
    -webkit-user-select: none;

    pointer-events: none;

    /*
      iOS에서 이미지 길게 누르기 방지
    */
    -webkit-touch-callout: none;
  }

  .legal-links {
    position: fixed;
    right: 32px;
    bottom: 28px;
    z-index: 100;

    display: flex;
    align-items: center;

    gap: 20px;

    padding: 5px 7px;

    background: #fff;
    color: #111;

    font-size: 12px;
    font-weight: 400;
    line-height: 1.2;
  }

  .legal-links a {
    display: block;
  }

  .legal-links a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (max-width: 760px) {
    .hero-image {
      /*
        핸드폰 세로에서 첫 화면 시작 위치
      */
      object-position: 60% 0%;
    }

    .legal-links {
      right: 18px;
      bottom: 18px;

      gap: 14px;

      padding: 5px 7px;

      font-size: 11px;
    }
  }
</style>