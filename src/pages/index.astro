---
import Header from "../components/Header.astro";

const heroImage = "/images/einsteigen-cover.webp";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="description"
      content="Juho Lee — Animation and Media Artist"
    />

    <title>Juho Lee</title>

    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon.png"
    />
  </head>

  <body>
    <main class="home">
      <img
        class="hero-image"
        src={heroImage}
        alt=""
        draggable="false"
      />

      <Header home />

      <div class="legal-links">
        <a href="/impressum">Impressum</a>
        <a href="/privacy">Privacy Policy</a>
      </div>
    </main>

    <script>
      const hero = document.querySelector(".hero-image");

      if (hero instanceof HTMLImageElement) {
        let current = 0;
        let target = 0;

        window.addEventListener(
          "wheel",
          (event) => {
            event.preventDefault();

            target += event.deltaY * 0.03;
            target = Math.max(0, Math.min(100, target));
          },
          { passive: false }
        );

        const animate = () => {
          current += (target - current) * 0.08;

          const xPosition =
            window.innerWidth <= 760 ? "60%" : "center";

          hero.style.objectPosition =
            `${xPosition} ${current}%`;

          requestAnimationFrame(animate);
        };

        animate();
      }
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html),
  :global(body) {
    width: 100%;
    height: 100%;
    margin: 0;
  }

  :global(body) {
    overflow: hidden;
    overscroll-behavior: none;
    background: #fff;
    color: #111;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 15px;
    line-height: 1.35;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .home {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background: #fff;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    z-index: 0;

    display: block;
    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center 0%;

    user-select: none;
    pointer-events: none;
  }

  .legal-links {
    position: fixed;
    right: 32px;
    bottom: 28px;
    z-index: 100;

    display: flex;
    align-items: center;
    gap: 20px;

    padding: 5px 7px;

    background: #fff;
    color: #111;

    font-size: 12px;
    font-weight: 400;
    line-height: 1.2;
  }

  .legal-links a {
    display: block;
  }

  .legal-links a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (max-width: 760px) {
    .legal-links {
      right: 18px;
      bottom: 18px;
      gap: 14px;
      padding: 5px 7px;
      font-size: 11px;
    }
  }
</style>