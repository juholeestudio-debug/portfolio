---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const projects = [
  {
    title: "CAT II",
    year: "2026",
    href: "/work/cat-ii",
    image: "/images/catII-cover.jpg",
  },
  {
    title: "rainbow rice cake",
    year: "2026",
    href: "/work/rainbow-rice-cake",
    image: "/images/rainbow-rice-cake-cover.jpg",
  },
  {
    title: "Opposable Thumb",
    year: "2025",
    href: "/work/opposable-thumb",
    image: "/images/oberbaumbruecke-cover.jpg",
  },
  {
    title: "Arena Waves",
    year: "2024",
    href: "/work/arena-waves",
    image: "/images/arenawaves-cover.png",
  },
  {
    title: "Random Box",
    year: "2022",
    href: "/work/random-box",
    image: "/images/randombox-cover.png",
  },
  {
    title: "A Parable of Proximity",
    year: "2021",
    href: "/work/a-parable-of-proximity",
    image: "/images/a-parable-of-proximity-cover.png",
  },
  {
    title: "Snake, 사랑방, Stand",
    year: "2021",
    href: "/work/snake-sarangbang-stand",
    image: "/images/snake-sarangbang-stand-cover.png",
  },
  {
    title: "delayed choice",
    year: "2021",
    href: "/work/delayed-choice",
    image: "/images/delayed-choice-cover.png",
  },
  {
    title: "vis-a-vis verification",
    year: "2021",
    href: "/work/vis-a-vis-verification",
    image: "/images/vis-a-vis-verification.png",
  },
];

const filmography = [
  {
    title: "Why Hasn't Everything Disappeared Yet",
    year: "2026",
    role: "Actor",
    href: "https://iffr.com/en/iffr/2026/films/why-hasnt-everything-disappeared-yet",
    image: "/images/why-hasnt-everything-disappeared-yet-cover.jpg",
  },
  {
    title: "Come As You Are",
    year: "2025",
    role: "Actor and model",
    href: "https://www.achtung-mode.com/achtung-presents-come-as-you-are/",
    image: "/images/come-as-you-are-cover.jpg",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="description"
      content="Selected work and filmography by Juho Lee"
    />

    <title>Work — Juho Lee</title>

    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon.png"
    />
  </head>

  <body>
    <Header />

    <main>
      <section class="work-section">
        <h1>Selected Work</h1>

        <div class="project-grid">
          {
            projects.map((project) => (
              <a class="project-card" href={project.href}>
                <img
                  src={project.image}
                  alt={project.title}
                  loading="lazy"
                />

                <div class="overlay"></div>

                <div class="project-info">
                  <h2>{project.title}</h2>
                  <span class="year">{project.year}</span>
                </div>
              </a>
            ))
          }
        </div>
      </section>

      <section class="work-section filmography-section">
        <h1>Filmography</h1>

        <div class="project-grid">
          {
            filmography.map((film) => (
              <a class="project-card" href={film.href}>
                <img
                  src={film.image}
                  alt={film.title}
                  loading="lazy"
                />

                <div class="overlay"></div>

                <div class="project-info">
                  <span class="role">{film.role}</span>
                  <h2>{film.title}</h2>
                  <span class="year">{film.year}</span>
                </div>
              </a>
            ))
          }
        </div>
      </section>
    </main>

    <div class="footer-container">
      <Footer />
    </div>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html),
  :global(body) {
    width: 100%;
    min-height: 100%;
    margin: 0;
  }

  :global(body) {
    background: #fff;
    color: #111;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 15px;
    line-height: 1.35;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  main {
    width: min(1120px, calc(100% - 270px));
    margin-left: 230px;
    padding: 47px 0 80px;
  }

  .work-section {
    margin-bottom: 80px;
  }

  .work-section:last-child {
    margin-bottom: 0;
  }

  h1 {
    margin: 0 0 16px;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
  }

  .project-card {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #ddd;
  }

  .project-card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms ease;
  }

  .overlay {
    position: absolute;
    inset: 0;

    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.72),
      rgba(0, 0, 0, 0.08) 65%,
      transparent
    );
  }

  .project-info {
    position: absolute;
    right: 20px;
    bottom: 18px;
    left: 20px;
    color: #fff;
  }

  .role {
    display: block;
    margin-bottom: 6px;
    font-size: 11px;
    font-weight: 700;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .project-info h2 {
    margin: 0;
    font-size: 30px;
    font-weight: 500;
    line-height: 1;
  }

  .year {
    display: block;
    margin-top: 6px;
    font-size: 12px;
  }

  .project-card:hover img {
    transform: scale(1.035);
  }

  .footer-container {
    width: min(1120px, calc(100% - 270px));
    margin-left: 230px;
    padding-bottom: 40px;
  }

  @media (max-width: 1100px) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    main {
      width: auto;
      margin-left: 0;
      padding: 70px 18px;
    }

    .work-section {
      margin-bottom: 60px;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }

    .footer-container {
      width: auto;
      margin-left: 0;
      padding: 0 18px 30px;
    }
  }
</style>