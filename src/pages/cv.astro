---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
<main>
  <p class="intro">
    Juho Lee is a Korean artist based in Cologne, Germany, working across
    drawing, animation, installation, and moving image.
  </p>

const education = [
  
  {
    year: "2021—",
    title: "Kunsthochschule für Medien Köln",
    text: "Media Arts / Animation",
  },
  {
    year: "2025—",
    title: "Kunstakademie Düsseldorf",
    text: "Katharina Wulff Class, guest student",
  },
];

const works = [
  {
    year: "2026",
    title: "Rainbow Rice Cake",
    text: "Graphic novel and animation",
  },
  {
    year: "2026",
    title: "CAT II",
    text: "Cologne Bonn Airport",
  },
  {
    year: "2025",
    title: "Opposable Thumb",
    text: "Oberbaumbrücke, Berlin",
  },
  {
    year: "2025",
    title: "Water",
    text: "Ahmedabad",
  },
  {
    year: "2023",
    title: "Arena Waves",
    text: "Trinitatiskirche, Cologne",
  },
  {
    year: "2022",
    title: "Data Mining",
    text: "São Paulo",
  },
  {
    year: "2022",
    title: "Feet Forward",
    text: "FUTUR 21",
  },
];

const performance = [
  {
    year: "2026",
    title: "Why Hasn't Everything Disappeared Yet",
    text: "Actor",
  },
  {
    year: "2025",
    title: "Come As You Are",
    text: "Actor and model",
  },
  {
    year: "2024",
    title: "Balenciaga Winter 2025",
    text: "Runway show, look 47",
  },
  {
    year: "2024—2025",
    title: "Balenciaga",
    text: "Showroom and internal productions",
  },
  {
    year: "2023—2026",
    title: "Tomorrow is another day",
    text: "Model, Düsseldorf",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="description"
      content="Curriculum vitae of Juho Lee"
    />

    <title>CV — Juho Lee</title>

    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon.png"
    />
  </head>

  <body>
    <Header />

    <main>
      <section>
        <h1>Education</h1>

        <div class="list">
          {
            education.map((item) => (
              <div class="entry">
                <span class="year">{item.year}</span>

                <div>
                  <p class="entry-title">{item.title}</p>
                  <p class="secondary">{item.text}</p>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <section>
        <h1>Selected Works</h1>

        <div class="list">
          {
            works.map((item) => (
              <div class="entry">
                <span class="year">{item.year}</span>

                <div>
                  <p class="entry-title">{item.title}</p>
                  <p class="secondary">{item.text}</p>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <section>
        <h1>Film &amp; Performance</h1>

        <div class="list">
          {
            performance.map((item) => (
              <div class="entry">
                <span class="year">{item.year}</span>

                <div>
                  <p class="entry-title">{item.title}</p>
                  <p class="secondary">{item.text}</p>
                </div>
              </div>
            ))
          }
        </div>
      </section>
    </main>

    <div class="footer-container">
      <Footer />
    </div>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html),
  :global(body) {
    width: 100%;
    min-height: 100%;
    margin: 0;
  }

  :global(body) {
    background: #fff;
    color: #111;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 15px;
    line-height: 1.35;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  main {
    width: min(760px, calc(100% - 330px));
    margin-left: 310px;
    padding: 47px 0 100px;
  }

  section {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 34px;
    margin-bottom: 68px;
  }

  h1 {
    margin: 0;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.35;
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .entry {
    display: grid;
    grid-template-columns: 90px minmax(0, 1fr);
    gap: 20px;
  }

  p {
    margin: 0;
  }

  .entry-title {
    font-weight: 500;
  }

  .year {
    font-weight: 400;
  }

  .secondary {
    opacity: 0.55;
    font-weight: 400;
  }

  .footer-container {
    width: min(760px, calc(100% - 330px));
    margin-left: 310px;
    padding-bottom: 40px;
  }

  @media (max-width: 760px) {
    main {
      width: auto;
      margin-left: 0;
      padding: 70px 18px;
    }

    section {
      grid-template-columns: 1fr;
      gap: 24px;
      margin-bottom: 54px;
    }

    .entry {
      grid-template-columns: 76px minmax(0, 1fr);
      gap: 14px;
    }

    .footer-container {
      width: auto;
      margin-left: 0;
      padding: 0 18px 30px;
    }
  }
</style>